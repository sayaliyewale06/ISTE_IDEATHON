{
  "rewrites": [
    { "source": "/api/auth/(.*)", "destination": "/api/auth?action=$1" },
    { "source": "/api/auth", "destination": "/api/auth" },
    { "source": "/api/task/(.*)", "destination": "/api/task?action=$1" },
    { "source": "/api/task", "destination": "/api/task" },
    { "source": "/api/premium/(.*)", "destination": "/api/premium?action=$1" },
    { "source": "/api/premium", "destination": "/api/premium" },
    { "source": "/api/coordination/(.*)", "destination": "/api/coordination?path=$1" },
    { "source": "/api/coordination", "destination": "/api/coordination" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
